process {
    withName: roary {
        container = 'docker://staphb/roary:3.13.0'
        cpus      = 8
        memory    = 16.GB
    }
    withName: panaroo {
        container = 'docker://staphb/panaroo:1.8.0'
        cpus      = 8
        memory    = 16.GB
    }
    withName: snp_sites {
        container = 'docker://staphb/snp-sites:2.5.1'
        cpus      = 1
        memory    = 4.GB
    }
    withName: snp_dists {
        container = 'docker://staphb/snp-dists:1.2.0'
        cpus      = 1
        memory    = 4.GB
    }
    withName: iqtree {
        container = 'docker://staphb/iqtree3:3.1.3'
        cpus      = 8
        memory    = 16.GB
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.container = null
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process.container = null
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        process.container = null
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.output}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,process,tag,status,exit,attempt,duration,realtime,%cpu,peak_rss'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.output}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.output}/pipeline_info/timeline.html"
}

process.errorStrategy = 'finish'
process.maxRetries    = 0
